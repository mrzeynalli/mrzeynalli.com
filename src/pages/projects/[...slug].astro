---
import { getCollection, getEntry, render, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPath } from "@/utils/getPath";
import getSortedProjects from "@/utils/getSortedProjects";
import projectFilter from "@/utils/projectFilter";
import postFilter from "@/utils/postFilter";
import { SITE } from "@/config";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.filter(projectFilter).map(project => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const {
  title,
  tagline,
  description,
  status,
  startDate,
  stack,
  liveUrl,
  repoUrl,
  screenshot,
  relatedPosts,
} = project.data;

const { Content } = await render(project);

const statusLabel = { live: "Live", wip: "In progress", archived: "Archived" }[
  status
];
const statusClass = {
  live: "badge-success",
  wip: "badge-warning",
  archived: "badge-ghost",
}[status];

const started = startDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
});

// Resolve the write-ups that belong to this project
const linked = (
  await Promise.all(relatedPosts.map(id => getEntry("blog", id)))
).filter(
  (post): post is CollectionEntry<"blog"> =>
    post !== undefined && postFilter(post)
);

const otherProjects = getSortedProjects(await getCollection("projects"))
  .filter(p => p.id !== project.id)
  .slice(0, 2);
---

<BaseLayout
  title={`${title} | ${SITE.title}`}
  description={description}
  sideBarActiveItemID="projects"
  ogType="article"
>
  <a
    href="/projects"
    class="text-sm text-base-content/50 transition-colors hover:text-primary"
  >
    ← All projects
  </a>

  <div class="mt-3 flex items-start justify-between gap-4">
    <h1 class="text-3xl font-bold leading-tight">{title}</h1>
    <span class:list={["badge shrink-0", statusClass]}>{statusLabel}</span>
  </div>

  <p class="mt-2 text-lg text-base-content/70">{tagline}</p>

  <div class="mt-3 flex flex-wrap items-center gap-3 text-sm text-base-content/50">
    <span>Started {started}</span>
    {
      liveUrl && (
        <a
          href={liveUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-primary hover:underline"
        >
          Live ↗
        </a>
      )
    }
    {
      repoUrl && (
        <a
          href={repoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-primary hover:underline"
        >
          Source ↗
        </a>
      )
    }
  </div>

  {
    stack.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-1.5">
        {stack.map(item => (
          <span class="badge badge-outline badge-sm">{item}</span>
        ))}
      </div>
    )
  }

  {
    screenshot && (
      <Image
        src={screenshot}
        alt={`${title} screenshot`}
        width={1200}
        height={675}
        class="mt-8 w-full rounded-xl border border-base-300"
      />
    )
  }

  <div class="divider my-8"></div>

  <article class="post-prose">
    <Content />
  </article>

  {
    linked.length > 0 && (
      <>
        <div class="divider my-8" />
        <h2 class="mb-4 text-xl font-bold">Write-ups</h2>
        <ul class="space-y-2">
          {linked.map(post => (
            <li>
              <a
                href={getPath(post.id, post.filePath)}
                class="text-primary hover:underline"
              >
                {post.data.title}
              </a>
            </li>
          ))}
        </ul>
      </>
    )
  }

  {
    otherProjects.length > 0 && (
      <>
        <div class="divider my-8" />
        <h2 class="mb-4 text-xl font-bold">Other projects</h2>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          {otherProjects.map(p => (
            <a
              href={`/projects/${p.id}`}
              class="rounded-lg bg-base-200/40 p-4 transition-colors hover:bg-base-200"
            >
              <div class="font-semibold">{p.data.title}</div>
              <div class="mt-1 text-sm text-base-content/60">{p.data.tagline}</div>
            </a>
          ))}
        </div>
      </>
    )
  }
</BaseLayout>
