---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SITE } from "@/config";
---

<BaseLayout title={`404 Not Found | ${SITE.title}`}>
  <div class="flex flex-col items-center justify-center py-20 text-center">
    <h1 class="text-8xl font-bold text-primary">404</h1>
    <span class="mt-2 text-base-content/40" aria-hidden="true">¯\_(ツ)_/¯</span>
    <p class="mt-4 text-2xl font-semibold">Page not found</p>
    <p class="mt-2 text-base-content/60">
      That page has moved, or never existed.
    </p>

    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn btn-primary btn-sm">Go home</a>
      <a href="/projects" class="btn btn-outline btn-sm">Projects</a>
      <a href="/blog" class="btn btn-outline btn-sm">Blog</a>
      <a href="/search" class="btn btn-ghost btn-sm">Search</a>
    </div>
  </div>
</BaseLayout>
