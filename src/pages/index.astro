---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import HorizontalCard from "@/components/HorizontalCard.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import getSortedProjects from "@/utils/getSortedProjects";

const recentPosts = getSortedPosts(await getCollection("blog")).slice(0, 4);

const allProjects = getSortedProjects(await getCollection("projects"));
const featuredProjects = allProjects.filter(p => p.data.featured);
const shownProjects = (
  featuredProjects.length > 0 ? featuredProjects : allProjects
).slice(0, 4);
---

<BaseLayout sideBarActiveItemID="home">
  <!-- Hero -->
  <section class="pb-10">
    <div class="text-sm text-base-content/50 mb-2">Hello</div>
    <h1 class="text-4xl font-bold mb-2">I'm Elvin Zeynalli</h1>
    <p class="text-lg text-base-content/70 mb-6 leading-relaxed">
      Business Analyst · Quantitative Researcher · Automation Engineer
    </p>

    <div class="text-sm text-base-content/60">
      Currently: PhD candidate at Sabanci University, researching RL for optimal trading execution & portfolio optimization.
    </div>

    <div class="flex gap-3 mt-8 flex-wrap">
      <a href="/projects" class="btn btn-primary btn-sm">View Projects</a>
      <a href="/about" class="btn btn-outline btn-sm">Resume</a>
      <a href="/contact" class="btn btn-ghost btn-sm">Contact</a>
    </div>
  </section>

  <div class="divider"></div>

  <!-- Featured projects -->
  {
    shownProjects.length > 0 && (
      <section>
        <div class="mb-6 flex items-baseline justify-between">
          <h2 class="text-2xl font-bold">Things I'm Building</h2>
          <a href="/projects" class="text-sm text-primary hover:underline">
            All projects →
          </a>
        </div>

        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
          {shownProjects.map(project => (
            <ProjectCard project={project} compact />
          ))}
        </div>
      </section>
    )
  }

  <div class="divider my-10"></div>

  <!-- Recent posts -->
  <section>
    <div class="mb-6 flex items-baseline justify-between">
      <h2 class="text-2xl font-bold">Recent Writing</h2>
      <a href="/blog" class="text-sm text-primary hover:underline">All posts →</a>
    </div>

    {
      recentPosts.map((post, i) => (
        <>
          <HorizontalCard {...post} />
          {i < recentPosts.length - 1 && <div class="divider my-1" />}
        </>
      ))
    }
  </section>
</BaseLayout>
