---
import type { Page } from "astro";

type Props = { page: Page };

const { page } = Astro.props;
---

{
  page.lastPage > 1 && (
    <nav class="mt-10 flex items-center justify-between" aria-label="Pagination">
      <a
        href={page.url.prev}
        class:list={[
          "btn btn-ghost btn-sm",
          { "pointer-events-none opacity-30": !page.url.prev },
        ]}
        aria-disabled={!page.url.prev}
      >
        ← Prev
      </a>

      <span class="text-sm text-base-content/50">
        Page {page.currentPage} of {page.lastPage}
      </span>

      <a
        href={page.url.next}
        class:list={[
          "btn btn-ghost btn-sm",
          { "pointer-events-none opacity-30": !page.url.next },
        ]}
        aria-disabled={!page.url.next}
      >
        Next →
      </a>
    </nav>
  )
}
