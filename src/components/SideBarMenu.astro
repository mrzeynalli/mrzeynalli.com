---
const { sideBarActiveItemID } = Astro.props;

// 24x24 stroke icons, rendered with currentColor
const icons = {
  home: `<path stroke-linecap="round" stroke-linejoin="round" d="M3 10.5 12 3l9 7.5M5.25 9.75V20a1 1 0 0 0 1 1h3.5v-5.5h4.5V21h3.5a1 1 0 0 0 1-1V9.75"/>`,
  projects: `<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 7.5A1.75 1.75 0 0 1 5.5 5.75h3.19c.46 0 .9.18 1.23.51l1.06 1.06h7.52c.97 0 1.75.78 1.75 1.75v8.68c0 .97-.78 1.75-1.75 1.75H5.5a1.75 1.75 0 0 1-1.75-1.75z"/>`,
  blog: `<path stroke-linecap="round" stroke-linejoin="round" d="M5.25 4.75h13.5v14.5H5.25zM8.5 8.5h7M8.5 12h7M8.5 15.5h4"/>`,
  archive: `<path stroke-linecap="round" stroke-linejoin="round" d="M5 8h14M5 8a2 2 0 1 1 0-4h14a2 2 0 1 1 0 4M5 8v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8m-9 4h4"/>`,
  tags: `<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 11.2V5a1.25 1.25 0 0 1 1.25-1.25h6.2c.33 0 .65.13.88.37l8 8a1.25 1.25 0 0 1 0 1.76l-6.2 6.2a1.25 1.25 0 0 1-1.77 0l-8-8a1.25 1.25 0 0 1-.36-.88Z"/><circle cx="8" cy="8" r="1.1"/>`,
  resume: `<path stroke-linecap="round" stroke-linejoin="round" d="M14 3.75H7A1.75 1.75 0 0 0 5.25 5.5v13c0 .97.78 1.75 1.75 1.75h10c.97 0 1.75-.78 1.75-1.75V8.5zM14 3.75V8.5h4.75M8.75 13h6.5M8.75 16.25h4"/>`,
  contact: `<path stroke-linecap="round" stroke-linejoin="round" d="M4.75 6.75h14.5v10.5H4.75zM4.75 7.5l7.25 5.25L19.25 7.5"/>`,
};

type Item = {
  id: string;
  href: string;
  label: string;
  icon?: keyof typeof icons;
  children?: { id: string; href: string; label: string }[];
};

const groups: { label?: string; items: Item[] }[] = [
  {
    items: [
      { id: "home", href: "/", label: "Home", icon: "home" },
      { id: "projects", href: "/projects", label: "Projects", icon: "projects" },
      {
        id: "blog",
        href: "/blog",
        label: "Blog",
        icon: "blog",
        children: [
          { id: "analytics", href: "/analytics", label: "Analytics" },
          { id: "quant-research", href: "/quant-research", label: "Quant Research" },
          { id: "automation", href: "/automation", label: "Automation" },
        ],
      },
    ],
  },
  {
    label: "Browse",
    items: [
      { id: "tags", href: "/tags", label: "Tags", icon: "tags" },
      { id: "archives", href: "/archives", label: "Archive", icon: "archive" },
    ],
  },
  {
    label: "Elsewhere",
    items: [
      { id: "about", href: "/about", label: "Resume", icon: "resume" },
      { id: "contact", href: "/contact", label: "Contact", icon: "contact" },
    ],
  },
];

const isActive = (id: string) => sideBarActiveItemID === id;

// A parent stays lit while you are inside one of its children
const childActive = (item: Item) =>
  item.children?.some(c => isActive(c.id)) ?? false;
---

<nav class="px-3 py-4">
  {
    groups.map(group => (
      <div class="mb-5 last:mb-0">
        {group.label && (
          <p class="text-base-content/40 mb-1.5 px-3 text-[0.65rem] font-semibold tracking-[0.12em] uppercase">
            {group.label}
          </p>
        )}
        <ul class="flex flex-col gap-0.5">
          {group.items.map(item => (
            <li>
              <a
                id={item.id}
                href={item.href}
                aria-current={isActive(item.id) ? "page" : undefined}
                class:list={[
                  "group relative flex items-center gap-3 rounded-lg py-2.5 ps-4 pe-3 text-sm transition-colors",
                  isActive(item.id)
                    ? "bg-primary/10 text-primary font-semibold"
                    : childActive(item)
                      ? "text-base-content font-medium"
                      : "text-base-content/75 hover:bg-base-300/60 hover:text-base-content",
                ]}
              >
                {/* Accent bar on the active row */}
                <span
                  class:list={[
                    "bg-primary absolute inset-y-1.5 start-0 w-[3px] rounded-full transition-opacity",
                    isActive(item.id) ? "opacity-100" : "opacity-0",
                  ]}
                  aria-hidden="true"
                />
                {item.icon && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-[1.05rem] w-[1.05rem] shrink-0"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    aria-hidden="true"
                    set:html={icons[item.icon]}
                  />
                )}
                {item.label}
              </a>

              {item.children && (
                <ul class="border-base-300 my-1 ms-[1.6rem] flex flex-col gap-0.5 border-s ps-3">
                  {item.children.map(child => (
                    <li>
                      <a
                        id={child.id}
                        href={child.href}
                        aria-current={isActive(child.id) ? "page" : undefined}
                        class:list={[
                          "block rounded-md px-3 py-1.5 text-[0.8rem] transition-colors",
                          isActive(child.id)
                            ? "bg-primary/10 text-primary font-semibold"
                            : "text-base-content/60 hover:bg-base-300/60 hover:text-base-content",
                        ]}
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</nav>
