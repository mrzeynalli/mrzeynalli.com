  LinkedIn: `<circle cx="4.983" cy="5.009" r="2.188"/><path d="M9.237 8.855v12.139h3.769v-6.003c0-1.584.298-3.118 2.262-3.118 1.937 0 1.961 1.811 1.961 3.218v5.904H21v-6.657c0-3.27-.704-5.783-4.526-5.783-1.835 0-3.065 1.007-3.568 1.96h-.051v-1.66H9.237zm-6.142 0H6.87v12.139H3.095z"/>`,
  Medium: `<path d="M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zM20.96 12c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z"/>`,
  Mail: `<path d="M20 4H4c-1.103 0-2 .897-2 2v12c0 1.103.897 2 2 2h16c1.103 0 2-.897 2-2V6c0-1.103-.897-2-2-2zm0 2v.511l-8 6.223-8-6.222V6h16zM4 18V9.044l7.386 5.745a.994.994 0 0 0 1.228 0L20 9.044 20.002 18H4z"/>`,
};
---

<div class="border-base-300 border-t px-4 pt-4 pb-5">
  <!-- Social icons -->
  <div class="flex justify-center gap-3 flex-wrap">
    {
      SOCIALS.filter(s => s.name !== "X").map(social => (
        <a
          href={social.href}
          target="_blank"
          rel="noopener noreferrer"
          title={social.name}
          aria-label={social.name}
          class="text-base-content/50 hover:text-base-content transition-colors"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            style="fill: currentColor"
            set:html={iconMap[social.name] ?? ""}
          />
        </a>
      ))
    }

    <a
      href="/rss.xml"
      title="RSS feed"
      aria-label="RSS feed"
      class="text-base-content/50 hover:text-base-content transition-colors"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        style="fill: currentColor"
      >
        <circle cx="4.75" cy="19.25" r="2.25"/>
        <path d="M3 10.5v3a7.5 7.5 0 0 1 7.5 7.5h3A10.5 10.5 0 0 0 3 10.5z"/>
        <path d="M3 3v3a15 15 0 0 1 15 15h3A18 18 0 0 0 3 3z"/>
      </svg>
    </a>
  </div>

  <a
    href="mailto:ezeynalli@hotmail.com"
    class="text-base-content/40 hover:text-base-content mt-3 block text-center text-[0.7rem] transition-colors"
  >
    ezeynalli@hotmail.com
  </a>
</div>

