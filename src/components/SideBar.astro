---
import { Image } from "astro:assets";
import SideBarMenu from "./SideBarMenu.astro";
import SideBarFooter from "./SideBarFooter.astro";
import { SITE_DESCRIPTION } from "@/config";

const { sideBarActiveItemID } = Astro.props;

// "Business Analyst / Quantitative Researcher / ..." -> three pills
const roles = SITE_DESCRIPTION.split("/").map(r => r.trim());
---

<div class="drawer-side z-40">
  <label for="my-drawer" aria-label="close sidebar" class="drawer-overlay">
    <span class="sr-only">Close sidebar</span>
  </label>
  <aside
    class="bg-base-200 border-base-300 flex min-h-screen w-80 flex-col border-e"
    transition:animate="none"
  >
    <!-- Profile -->
    <div class="relative">
      <!-- Soft banner behind the avatar -->
      <div
        class="from-primary/25 via-primary/5 h-24 bg-gradient-to-br to-transparent"
        aria-hidden="true"
      >
      </div>

      <!-- Theme toggle -->
      <button
        id="theme-btn"
        class="btn btn-ghost btn-sm btn-circle text-base-content/60 hover:text-base-content absolute top-3 left-3"
        aria-label="Toggle theme"
        title="Toggle light / dark"
      >
        <svg
          id="theme-icon-moon"
          xmlns="http://www.w3.org/2000/svg"
          class="h-4 w-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
        <svg
          id="theme-icon-sun"
          xmlns="http://www.w3.org/2000/svg"
          class="hidden h-4 w-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
      </button>

      <!-- Search -->
      <a
        href="/search"
        class="btn btn-ghost btn-sm btn-circle text-base-content/60 hover:text-base-content absolute top-3 right-3"
        aria-label="Search"
        title="Search"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-4 w-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </a>

      <div class="-mt-16 px-6 pb-5 text-center">
        <a href="/" class="group inline-block" aria-label="Home">
          <span
            class="ring-base-100 bg-base-100 ring-offset-primary/30 group-hover:ring-offset-primary block rounded-full ring-4 ring-offset-2 transition-all duration-300"
          >
            <Image
              src="/me.jpg"
              alt="Elvin Zeynalli"
              width={288}
              height={288}
              loading="eager"
              fetchpriority="high"
              transition:persist="avatar"
              class="h-32 w-32 rounded-full object-cover"
            />
          </span>
        </a>

        <h1 class="mt-4 text-xl leading-tight font-bold tracking-tight">
          Elvin Zeynalli
        </h1>

        <a
          href="https://github.com/mrzeynalli"
          target="_blank"
          rel="noopener noreferrer"
          class="text-base-content/50 hover:text-primary mt-0.5 inline-block font-mono text-xs transition-colors"
        >
          @mrzeynalli
        </a>

        <ul class="mt-3 flex flex-wrap justify-center gap-1">
          {
            roles.map(role => (
              <li class="bg-base-300/70 text-base-content/70 rounded-full px-2.5 py-1 text-[0.65rem] font-medium">
                {role}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Navigation -->
    <div class="border-base-300 flex-1 overflow-y-auto border-t">
      <SideBarMenu sideBarActiveItemID={sideBarActiveItemID} />
    </div>

    <SideBarFooter />
  </aside>
</div>
